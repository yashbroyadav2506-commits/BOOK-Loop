# ==============================================================================
# Pallotti BookLoop — Environment Configuration Template
# Copy this file to .env and configure with your real values.
# NEVER commit .env to version control!
# ==============================================================================

# Core Flask App Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
SESSION_COOKIE_SECURE=False
BOOKS_PER_PAGE=9

# Database Configuration (PostgreSQL / Neon / Supabase / SQLite)
# Local SQLite default:
DATABASE_URL=sqlite:///pallotti_bookloop.db
# Hosted PostgreSQL format:
# DATABASE_URL=postgresql+psycopg://username:password@ep-xyz.us-east-2.aws.neon.tech/bookloop?sslmode=require

# Allowed College Email Domains (comma-separated; leave blank for open registration)
ALLOWED_EMAIL_DOMAINS=stvincentngp.edu.in,pallottine.org

# Rate Limiting & Storage (Flask-Limiter)
# In development, defaults to in-memory: memory://
# In serverless/production, configure Upstash Redis or Redis URI:
# UPSTASH_REDIS_URL=rediss://default:password@xyz.upstash.io:6379
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Transactional Email Providers (Choose Resend or Brevo; fallback to console in dev)
# Provider 1: Resend (https://resend.com)
RESEND_API_KEY=
# Provider 2: Brevo / Sendinblue (https://brevo.com)
BREVO_API_KEY=
# Sender Email Address
MAIL_DEFAULT_SENDER=noreply@pallottibookloop.in

# External Object Storage for Book Cover Images (Cloudinary)
# Sign up free at https://cloudinary.com
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Automated Stale Listing Cleanup Cron Secret
# Used to secure /api/v1/cron/expire-stale-books endpoint
CRON_SECRET=generate-a-secure-random-token-for-cron-triggers
